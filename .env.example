# Movie Night environment variables
# Copy this file to `.env.local` and fill in your credentials.

# TMDB (The Movie Database) API key — required.
# Get a free key at https://www.themoviedb.org/settings/api
# A v3 API key (short) works. A v4 read access token (long, JWT-style) also works.
TMDB_API_KEY=

# Default country used for streaming availability (ISO 3166-1 alpha-2).
# Optional — defaults to US.
NEXT_PUBLIC_DEFAULT_COUNTRY=US

# Optional: a dedicated streaming-availability provider can be added later.
# The streaming abstraction (lib/streaming.ts) is provider-agnostic so this
# can be swapped in without rewriting the app.
# STREAMING_API_KEY=
